<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121722"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/wake_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="アラーム鳴動中"
        android:textColor="#F43F5E"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/wake_fade_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="♪ 音量フェードイン中"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/wake_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/ic_tile_alarm"
        android:contentDescription="icon" />

    <TextView
        android:id="@+id/wake_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="#FFFFFF"
        android:textSize="64sp"
        android:textStyle="bold"
        android:text="07:00" />

    <TextView
        android:id="@+id/wake_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#E2E8F0"
        android:textSize="22sp"
        android:textStyle="bold"
        android:text="「YouTube」を開きますか？" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 停止ボタン -->
    <Button
        android:id="@+id/btn_wake_stop"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:backgroundTint="#FFFFFF"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="@string/stop" />

    <!-- スヌーズボタン -->
    <Button
        android:id="@+id/btn_wake_snooze"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#1E293B"
        android:textColor="#E2E8F0"
        android:textSize="15sp"
        android:text="@string/snooze" />

</LinearLayout>
